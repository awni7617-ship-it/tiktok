# Phantom — environment configuration.
#
# Copy to `.env` and fill in what you need. Everything except DATABASE_URL has a
# working default: with no API keys at all the platform runs on deterministic
# offline providers, so you can explore the whole product before configuring
# anything.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

DATABASE_URL=postgresql://phantom:phantom@localhost:5432/phantom

# Generate with: openssl rand -base64 48
# The app refuses to start in production while these are placeholders.
SESSION_SECRET=dev-only-session-secret-change-me-now!!
ENCRYPTION_KEY=dev-only-encryption-key-change-me-now!!

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local           # local | s3 | r2
STORAGE_LOCAL_PATH=./storage

# S3-compatible (AWS, Cloudflare R2, MinIO)
# S3_BUCKET=phantom-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://media.example.com

# ---------------------------------------------------------------------------
# AI providers
#
# Each capability falls back to the deterministic mock when its key is absent.
# ---------------------------------------------------------------------------
AI_LLM_PROVIDER=mock           # anthropic | mock
AI_ASR_PROVIDER=mock           # openai | deepgram | mock
AI_TTS_PROVIDER=mock           # elevenlabs | openai | mock
AI_IMAGE_PROVIDER=mock         # openai | mock

# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max

# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Rendering
#
# local     — spawn ffmpeg in this process (Node server or render container)
# container — delegate to the Cloudflare Container (what the Worker uses)
# disabled  — no rendering; everything else still works
# ---------------------------------------------------------------------------
RENDER_MODE=local

# ---------------------------------------------------------------------------
# Media tooling
# ---------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TMP_DIR=./tmp/media
MAX_UPLOAD_BYTES=2147483648
# FONTS_DIR=/usr/share/fonts

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1500
JOB_MAX_ATTEMPTS=4

# ---------------------------------------------------------------------------
# Observability & limits
# ---------------------------------------------------------------------------
LOG_LEVEL=debug                # debug | info | warn | error
LOG_FORMAT=pretty              # pretty | json
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---------------------------------------------------------------------------
# Social platforms
#
# Each platform stays disabled in the UI until both of its values are set.
# Redirect URI is always: {APP_URL}/api/social/{platform}/callback
# ---------------------------------------------------------------------------
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare
#
# Not needed for local development. On Workers these come from bindings and
# `wrangler secret put` rather than a .env file — see docs/cloudflare.md.
#
#   STORAGE_DRIVER=r2        media served by the R2 binding
#   RENDER_MODE=container    ffmpeg runs in the Container, not the Worker
#
# Shared secret the Worker presents when waking the render container:
#   npx wrangler secret put CONTAINER_TOKEN
# CONTAINER_TOKEN=
