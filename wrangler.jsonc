{
  // Phantom on Cloudflare — base deployment.
  //
  // This config deploys the Next.js app as a Worker and nothing else, because
  // that is the only part needing no resource you have not created yet. It
  // binds R2 (created by `npm run cf:setup`) and reads Postgres from the
  // `DATABASE_URL` secret.
  //
  // Rendering is OFF here (`RENDER_MODE: disabled`): ffmpeg is a native binary
  // and a Worker cannot run one. Two ways to turn it on:
  //
  //   - Cloudflare Containers — `wrangler.containers.jsonc`, deployed with
  //     `npm run cf:deploy:full`. Needs Docker locally and a paid plan.
  //   - Any host with ffmpeg (Fly, Railway, a VM) running `npm run worker`
  //     against the same Postgres and R2. See docs/cloudflare.md.
  //
  // Anything added here must also be added to `wrangler.containers.jsonc`;
  // that file is this one plus Hyperdrive, the container and the cron trigger.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phantom",
  // The wrapper re-exports the OpenNext handler and adds the cron handler.
  // OpenNext alone exports only `fetch`.
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2025-03-25",
  // Required by OpenNext, and by Prisma's pg driver adapter.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    "NODE_ENV": "production",
    "STORAGE_DRIVER": "r2",
    // No ffmpeg and no container in this config, so rendering is off rather
    // than broken — the health endpoint reports that honestly instead of
    // accepting exports that could never run.
    "RENDER_MODE": "disabled",
    "LOG_FORMAT": "json",
    "AI_LLM_PROVIDER": "mock"
  },

  // Media. The binding avoids SigV4 and keeps the AWS SDK out of the bundle.
  // The bucket must exist: `npx wrangler r2 bucket create phantom-media`.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "phantom-media"
    }
  ]
}
