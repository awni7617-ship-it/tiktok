{
  "name": "phantom",
  "version": "0.1.0",
  "private": true,
  "description": "Phantom — AI content creation platform for short-form video creators.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/server/jobs/worker-entry.ts",
    "worker:dev": "tsx watch src/server/jobs/worker-entry.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/cloudflare-preflight.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "container": "tsx src/server/jobs/container-entry.ts",
    "cf:check": "node scripts/cloudflare-preflight.mjs",
    "cf:setup": "node scripts/cloudflare-preflight.mjs --fix",
    "cf:deploy:full": "node scripts/cloudflare-preflight.mjs --containers && opennextjs-cloudflare build && wrangler deploy --config wrangler.containers.jsonc",
    "package:editor": "node scripts/package-editor.mjs",
    "cf:build:ci": "prisma generate && opennextjs-cloudflare build",
    "cf:deploy:ci": "npm run cf:build:ci && opennextjs-cloudflare deploy",
    "deploy": "npm run cf:deploy:ci",
    "desktop": "npm run package:editor && electron .",
    "desktop:build": "electron-builder --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@cloudflare/containers": "^0.3.7",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^6.1.0",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.116.0"
  },
  "main": "desktop/main.js"
}
